# All fields are optional. Synchronization stays disabled until explicitly enabled.

[daemon]
# socket_path = "/run/user/1000/kclip/kclipd.sock"
max_content_size = 10485760
history_limit = 10
history_max_age = "24h"
tombstone_retention = "30d"

[storage]
# database_path = "/home/example/.local/share/kclip/kclip.db"
# blob_directory = "/home/example/.local/share/kclip/blobs"

# Plasma remains reserved for a later implementation.
[plasma]
enabled = false
mirror_slot = "default"
desktop_to_slot = false
slot_to_desktop = true
text_only = true

[sync]
enabled = false
relay_url = "wss://clipboard.example.invalid/sync/v1"
reconnect_min_delay = "1s"
reconnect_max_delay = "5m"
device_name = "workstation"
# token_path = "/home/example/.config/kclip/token.json"
# Development tests only. Production relay URLs must use wss://.
allow_insecure_transport = false

[security]
require_encrypted_sync = true
# identity_path = "/home/example/.local/share/kclip/identity"
# sync_key_path = "/home/example/.local/share/kclip/sync.key"

[slots.default]
sync = true
history_limit = 10
history_max_age = "24h"
plasma_mirror = true
