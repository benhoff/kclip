# Fields may be omitted while synchronization is disabled. `kclip sync setup`
# populates the fields required to enable it.

[daemon]
# socket_path = "/run/user/1000/kclip/kclipd.sock"
max_content_size = 10485760
history_limit = 10
history_max_age = "24h"
tombstone_retention = "30d"

[storage]
# database_path = "/home/example/.local/share/kclip/kclip.db"
# blob_directory = "/home/example/.local/share/kclip/blobs"

# Plasma integration uses Klipper's session D-Bus API and currently mirrors
# non-empty UTF-8 text only. Enabling desktop_to_slot makes desktop clipboard
# text durable and eligible for synchronization according to the slot policy.
[plasma]
enabled = false
mirror_slot = "default"
desktop_to_slot = false
slot_to_desktop = true
text_only = true

[sync]
enabled = false
relay_url = "ws://192.168.1.50:8001/sync/v1"
# account_name is populated by `kclip sync setup`.
reconnect_min_delay = "1s"
reconnect_max_delay = "5m"
device_name = "workstation"
# pairing_path = "/home/example/.config/kclip/pairing.json"

[security]
require_encrypted_sync = true
# identity_path = "/home/example/.local/share/kclip/identity"
# sync_key_path = "/home/example/.local/share/kclip/sync.key"

[slots.default]
sync = true
history_limit = 10
history_max_age = "24h"
plasma_mirror = true
